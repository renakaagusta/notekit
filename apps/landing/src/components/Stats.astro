---
// Stats section with key metrics
const stats = [
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg>`,
    label: "24h Volume",
    value: "$1.2B",
    change: "+5.2%",
    positive: true
  },
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    label: "Current APY",
    value: "12.5%",
    change: "+0.5%",
    positive: true
  },
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    label: "TVL",
    value: "$450M",
    change: "+2.1%",
    positive: true
  }
];
---

<section class="py-12 bg-surface-secondary border-y border-border">
  <div class="section-container">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-4">
      {stats.map((stat, index) => (
        <div class={`flex items-center gap-4 justify-center md:justify-start ${index !== stats.length - 1 ? 'md:border-r md:border-border' : ''}`}>
          <div class="p-3 bg-surface-tertiary rounded-xl text-gray-400" set:html={stat.icon}></div>
          <div>
            <p class="text-sm text-gray-500 uppercase tracking-wider font-medium">{stat.label}</p>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl md:text-3xl font-heading font-bold text-white">{stat.value}</span>
              <span class={`text-sm font-medium flex items-center gap-1 ${stat.positive ? 'text-success' : 'text-red-500'}`}>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <path d={stat.positive ? "M7 17l5-5 5 5" : "M7 7l5 5 5-5"}/>
                </svg>
                {stat.change}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
