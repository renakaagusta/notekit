---
import TechStackMarquee from "./TechStackMarquee";
import { FadeIn } from "./ui/fade-in";
---

<section
  class="py-20 relative overflow-hidden"
  style="background-color: #050505;"
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-8 lg:px-[120px] mb-12">
    <!-- Section Header -->
    <FadeIn client:visible className="text-center max-w-[600px] mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-[52px] leading-[40px] md:leading-[52px] lg:leading-[62px] font-['Schibsted_Grotesk'] font-medium tracking-[-2%] mb-4 text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60">
        Open Standards, All the Way Down
      </h2>
      <p class="text-lg text-[#CACACA] font-body font-normal leading-7 tracking-[-1%]">
        No proprietary formats. No lock-in. Every component is replaceable.
      </p>
    </FadeIn>
  </div>

  <!-- Marquee -->
  <FadeIn client:visible delay={0.2} y={20}>
    <TechStackMarquee client:load />
  </FadeIn>
</section>
