---
// Problem vs Solution - Comparison Cards with Glassmorphism
import ScaleXLogoWhite from "../assets/images/ScaleX-Logo-White.png";
---

<section
  class="py-24 relative overflow-hidden"
  style="background-color: #050505;"
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-8 lg:px-[120px]">
    <!-- Section Header -->
    <div class="text-center mb-[52px] max-w-[534px] mx-auto" data-reveal>
      <h2 class="text-3xl md:text-4xl lg:text-[52px] leading-[42px] md:leading-[52px] lg:leading-[62px] font-['Schibsted_Grotesk'] font-medium tracking-[-2%] mb-4 text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60">
        Other DEXs vs ScaleX.
      </h2>
      <p class="text-lg text-[#CACACA] font-body font-normal leading-7 tracking-[-1%]">
        Stop Leaving Money on the Table, Every second your limit order
        waits, you're losing potential yield. ScaleX changes that.
      </p>
    </div>

    <!-- Comparison Cards -->
    <div
      class="flex flex-col md:flex-row items-center gap-6 max-w-[900px] mx-auto justify-center"
    >
      <!-- Other DEXs Card -->
      <div
        class="glass-card glow-top-gray flex-1 max-w-[396px] w-full flex flex-col gap-6" data-reveal
      >
        <!-- Heading -->
        <div class="flex flex-col items-center gap-3">
          <div class="flex items-center gap-3 justify-center">
            <div
              class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10"
              style="background: linear-gradient(0deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 46%); background-color: #2C2C2C; box-shadow: 0px 2.77px 11.08px -1.38px rgba(41,43,50,0.5);"
            >
              <svg
                class="w-4 h-5 text-gray-400"
                viewBox="0 0 16 22"
                fill="currentColor"
              >
                <path
                  d="M8 0L0 4v6c0 5.55 3.41 10.74 8 12 4.59-1.26 8-6.45 8-12V4L8 0z"
                ></path>
              </svg>
            </div>
            <span class="text-white text-xl font-heading font-medium leading-6"
              >Other DEXs</span
            >
          </div>
          <p
            class="text-white/60 text-base font-body font-normal leading-6 text-center"
          >
            When your limit order hasn't executed, your capital just sits idle
            and earning nothing.
          </p>
        </div>

        <!-- Divider -->
        <div class="w-full h-px bg-white/10 z-[1]"></div>

        <!-- Checklist -->
        <div class="flex flex-col gap-3 z-[2]">
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[18px] h-[18px] text-red-400/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="10" cy="10" r="9"></circle>
                <path d="M13 7L7 13M7 7l6 6"></path>
              </svg>
            </div>
            <span class="text-white/60 text-base font-body font-normal leading-6">Funds sit idle while limit orders wait</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[18px] h-[18px] text-red-400/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="10" cy="10" r="9"></circle>
                <path d="M13 7L7 13M7 7l6 6"></path>
              </svg>
            </div>
            <span class="text-white/60 text-base font-body font-normal leading-6">No yield generated during order delay</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[18px] h-[18px] text-red-400/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="10" cy="10" r="9"></circle>
                <path d="M13 7L7 13M7 7l6 6"></path>
              </svg>
            </div>
            <span class="text-white/60 text-base font-body font-normal leading-6">Hidden opportunity cost over time</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[18px] h-[18px] text-red-400/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="10" cy="10" r="9"></circle>
                <path d="M13 7L7 13M7 7l6 6"></path>
              </svg>
            </div>
            <span class="text-white/60 text-base font-body font-normal leading-6">Capital locked with zero productivity</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[18px] h-[18px] text-red-400/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="10" cy="10" r="9"></circle>
                <path d="M13 7L7 13M7 7l6 6"></path>
              </svg>
            </div>
            <span class="text-white/60 text-base font-body font-normal leading-6">No safety guardrails for AI agent trading</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[18px] h-[18px] text-red-400/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="10" cy="10" r="9"></circle>
                <path d="M13 7L7 13M7 7l6 6"></path>
              </svg>
            </div>
            <span class="text-white/60 text-base font-body font-normal leading-6">No prediction markets to earn from market views</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[18px] h-[18px] text-red-400/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="10" cy="10" r="9"></circle>
                <path d="M13 7L7 13M7 7l6 6"></path>
              </svg>
            </div>
            <span class="text-white/60 text-base font-body font-normal leading-6">Centralized oracle dependencies for settlement</span>
          </div>
        </div>
      </div>

      <!-- VS Divider -->
      <div class="flex md:flex-col items-center gap-4 md:h-[326px] py-4 w-full md:w-auto">
        <div class="flex-1 md:w-px h-px md:h-auto w-full bg-gradient-to-r md:bg-gradient-to-b from-transparent via-white/10 to-white/10"></div>
        <div
          class="w-[60px] h-[60px] rounded-full flex items-center justify-center border border-white/10 flex-shrink-0"
          style="background: linear-gradient(180deg, #050505 0%, #232323 100%); box-shadow: 0px 4px 12px 1px rgba(13,36,122,0.12);"
        >
          <span class="text-white/60 text-sm font-heading font-bold">VS</span>
        </div>
        <div class="flex-1 md:w-px h-px md:h-auto w-full bg-gradient-to-r md:bg-gradient-to-b from-white/10 via-white/10 to-transparent"></div>
      </div>

      <!-- ScaleX Card -->
      <div
        class="glass-card glass-card-orange glow-top-orange flex-1 max-w-[396px] w-full flex flex-col gap-6" data-reveal="delay-2"
      >
        <!-- Heading -->
        <div class="flex flex-col items-center gap-3">
          <div class="flex items-center gap-3 justify-center">
            <div
              class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10"
              style="background: linear-gradient(0deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 46%); background-color: #F06718; box-shadow: 0px 2.77px 11.08px -1.38px rgba(41,43,50,0.5);"
            >
              <img src={ScaleXLogoWhite.src} alt="ScaleX" class="w-5 h-5" />
            </div>
            <span class="text-white text-xl font-['Schibsted_Grotesk'] font-medium leading-6 tracking-[-1%]">ScaleX</span>
          </div>
          <p class="text-white text-base font-body font-normal leading-6 text-center tracking-[-2%]">
            Instead of sitting idle, ScaleX puts your liquidity to work and generating passive yield.
          </p>
        </div>

        <!-- Divider -->
        <div class="w-full h-px bg-primary/30 z-[1]"></div>

        <!-- Checklist -->
        <div class="flex flex-col gap-3 z-[2]">
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[19px] h-[19px] text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-white text-base font-body font-normal leading-6">Earn yield while waiting</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[19px] h-[19px] text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-white text-base font-body font-normal leading-6">Up to +12.5% APY on idle capital</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[19px] h-[19px] text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-white text-base font-body font-normal leading-6">Turn idle into passive income</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[19px] h-[19px] text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-white text-base font-body font-normal leading-6">More efficient, capital-optimized trading</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[19px] h-[19px] text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-white text-base font-body font-normal leading-6">Deploy AI agents with ERC-8004 identity and on-chain policy engine</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[19px] h-[19px] text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-white text-base font-body font-normal leading-6">Binary prediction markets with yield while staked</span>
          </div>
          <div class="flex items-start gap-2">
            <div class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
              <svg class="w-[19px] h-[19px] text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-white text-base font-body font-normal leading-6">Chainlink CRE trustless settlement</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
