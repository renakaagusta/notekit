{
  "name": "notekit",
  "version": "0.1.0",
  "private": true,
  "description": "Notes + tickets in your Git repo. OSS, MCP-first.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.12.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "turbo": "^2.1.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0"
    }
  }
}
