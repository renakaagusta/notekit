---
// CTA Section - Banner with gradient background
import bgCTA from "../assets/images/Background-CTA.png";
import pattern from "../assets/images/Pattern.svg";
import { FadeIn, StaggerContainer, StaggerItem } from "./ui/fade-in";
---

<section
  class="py-10 relative overflow-hidden"
  style="background-color: #050505;"
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-8 lg:px-[120px]">
    <!-- CTA Banner -->
    <FadeIn client:visible>
      <div
        class="relative rounded-3xl overflow-hidden px-5 py-12 sm:px-10 sm:py-20 flex flex-col items-center border border-white/5"
      >
        <!-- Background Images -->
        <div class="absolute inset-0 z-0">
          <img src={bgCTA.src} alt="" class="w-full h-full object-cover" />
        </div>
        <div class="absolute inset-0 z-0 flex items-end">
          <img
            src={pattern.src}
            alt=""
            class="w-full h-auto object-cover opacity-80 mix-blend-lighten"
          />
        </div>

        <StaggerContainer client:visible stagger={0.18} className="flex flex-col items-center">
          <!-- Heading -->
          <StaggerItem>
            <h2
              class="relative z-10 text-[28px] leading-[36px] sm:text-[40px] sm:leading-[50px] lg:text-[52px] lg:leading-[62px] font-['Schibsted_Grotesk'] font-medium tracking-[-2%] mb-4 text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60 text-center"
            >
              Ready to Earn More?
            </h2>
          </StaggerItem>

          <!-- Description -->
          <StaggerItem>
            <p
              class="relative z-10 text-lg text-[#CACACA] font-body font-normal leading-7 text-center tracking-[-1%] mb-8"
            >
              Join traders who refuse to let their capital sit idle. Start<br
              />earning yield on every order today.
            </p>
          </StaggerItem>

          <!-- CTA Buttons -->
          <StaggerItem>
            <div class="relative z-10 flex flex-col sm:flex-row items-center gap-4">
              <a
                href="https://base-sepolia-app.scalex.money"
                target="_blank"
                rel="noopener"
                class="btn-primary text-base group"
              >
                <svg
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                Launch App
              </a>
              <a
                href="https://scalex.mintlify.app/genesis-story"
                target="_blank"
                rel="noopener"
                class="btn-secondary text-base group"
              >
                <svg
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  ></path>
                </svg>
                Read Docs
              </a>
              <a
                href="https://scalex.mintlify.app/architecture/agent"
                target="_blank"
                rel="noopener"
                class="btn-secondary text-base group"
              >
                <svg
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                Build Your Agent
              </a>
            </div>
          </StaggerItem>
        </StaggerContainer>
      </div>
    </FadeIn>
  </div>
</section>
