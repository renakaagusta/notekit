  id="features"
  style="background-color: #050505;"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">

    <!-- Bento Grid -->
    <div data-reveal="delay-1">
      <FeaturesBento client:load />
    </div>
  </div>
</section>
