---
import star from "../assets/images/Star.svg";

const features = [
  {
    name: "E2EE by Default",
    desc: "Notes encrypted before leaving your device.",
    notekit: { value: "Yes", detail: "(age/X25519)", hasCheck: true },
    notion: { value: "No", detail: "(plaintext cloud)" },
    obsidian: { value: "No", detail: "(local only)" },
    obsidianSync: { value: "Optional", detail: "(trust Obsidian)" },
  },
  {
    name: "Git-Backed History",
    desc: "Full diff, blame, and rollback.",
    notekit: { value: "Yes", detail: "(every save = commit)", hasCheck: true },
    notion: { value: "No" },
    obsidian: { value: "No" },
    obsidianSync: { value: "No" },
  },
  {
    name: "Open Source",
    desc: "Clients MIT, server AGPL.",
    notekit: { value: "Yes", detail: "(MIT + AGPL)", hasCheck: true },
    notion: { value: "No" },
    obsidian: { value: "Partial", detail: "(closed core)" },
    obsidianSync: { value: "No" },
  },
  {
    name: "Offline-First",
    desc: "Works without internet.",
    notekit: { value: "Yes", hasCheck: true },
    notion: { value: "Limited" },
    obsidian: { value: "Yes" },
    obsidianSync: { value: "Yes" },
  },
  {
    name: "AI Agent / MCP Access",
    desc: "Least-privilege note grants via MCP.",
    notekit: { value: "Yes", detail: "(MCP server)", hasCheck: true },
    notion: { value: "API only", detail: "(no E2EE)" },
    obsidian: { value: "No" },
    obsidianSync: { value: "No" },
  },
  {
    name: "Self-Hostable",
    desc: "Run your own sync server.",
    notekit: { value: "Yes", detail: "(Forgejo + AGPL)", hasCheck: true },
    notion: { value: "No" },
    obsidian: { value: "Yes", detail: "(local vault)" },
    obsidianSync: { value: "No" },
  },
  {
    name: "BYO Git Repo",
    desc: "Bring your own GitHub / GitLab.",
    notekit: { value: "Yes", hasCheck: true },
    notion: { value: "No" },
    obsidian: { value: "Plugin", detail: "(community)" },
    obsidianSync: { value: "No" },
  },
  {
    name: "Mobile App",
    desc: "iOS and Android native.",
    notekit: { value: "Yes", detail: "(Capacitor)", hasCheck: true },
    notion: { value: "Yes" },
    obsidian: { value: "Yes" },
    obsidianSync: { value: "Yes" },
  },
];
---

<section class="py-0 relative overflow-hidden" id="compare" style="background-color: #050505;">
  <div class="max-w-[1440px] mx-auto px-3">
    <div class="rounded-[20px] sm:rounded-[32px] py-12 sm:py-[100px] px-4 sm:px-8 lg:px-[108px] bg-gradient-to-b from-[#0C0C0C] to-[#050505]">
      <!-- Section Header -->
      <div class="text-center mb-10 sm:mb-[52px] max-w-[534px] mx-auto" data-reveal>
        <h2 class="text-3xl md:text-4xl lg:text-[52px] leading-[40px] md:leading-[52px] lg:leading-[62px] font-['Schibsted_Grotesk'] font-medium tracking-[-2%] mb-4 text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60">
          NoteKit vs The Alternatives
        </h2>
        <p class="text-base sm:text-lg text-white/80 font-body font-normal leading-6 sm:leading-7 tracking-[-1%]">
          See how NoteKit stacks up on the things<br class="hidden sm:block"/> that actually matter.
        </p>
      </div>

      <!-- Desktop Table (md+) -->
      <div class="hidden md:block w-full">
        <div class="border border-white/20 rounded-2xl overflow-hidden">
          <!-- Header Row -->
          <div class="flex border-b border-white/20">
            <div class="flex-1 px-6 py-4 flex items-center">
              <span class="text-white text-lg font-body font-medium leading-7 tracking-[-1%]">Features</span>
            </div>
            <div class="flex-1 flex items-center justify-start gap-3 px-6 py-4 border-t-[3px] border-t-primary"
              style="background-color: rgba(234, 115, 23, 0.1);">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center"
                style="background-color: #ea7317; box-shadow: 0px 2.77px 11.08px -1.38px rgba(41,43,50,0.5);">
                <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
                  <path d="M8 10h10M8 16h16M8 22h12" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </div>
              <span class="text-white text-lg font-heading font-medium leading-7">NoteKit</span>
            </div>
            <div class="flex-1 flex items-center justify-start gap-3 px-6 py-4">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10"
                style="background-color: #2C2C2C;">
                <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                </svg>
              </div>
              <span class="text-white text-lg font-heading font-medium leading-7">Notion</span>
            </div>
            <div class="flex-1 flex items-center justify-start gap-3 px-6 py-4">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10"
                style="background-color: #2C2C2C;">
                <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              </div>
              <span class="text-white text-lg font-heading font-medium leading-7">Obsidian Sync</span>
            </div>
          </div>

          <!-- Data Rows -->
          {features.map((feature, index) => (
            <div class={`flex ${index < features.length - 1 ? 'border-b border-white/20' : ''}`}>
              <div class="flex-1 px-6 py-4 flex flex-col gap-1.5 justify-center">
                <span class="text-white text-base font-body font-medium leading-5">{feature.name}</span>
                <span class="text-white/80 text-sm font-body font-normal leading-5">{feature.desc}</span>
              </div>
              <div class="flex-1 px-6 py-4 flex items-center gap-2.5"
                style="background-color: rgba(234, 115, 23, 0.1);">
                <div class="flex items-center gap-1 flex-1">
                  <span class="text-white text-base font-body font-normal leading-5">{feature.notekit.value}</span>
                  {feature.notekit.detail && (
                    <span class="text-white/80 text-sm font-body font-normal leading-5">{feature.notekit.detail}</span>
                  )}
                </div>
                {feature.notekit.hasCheck && (
                  <img src={star.src} alt="Star" class="w-5 h-5" />
                )}
              </div>
              <div class="flex-1 px-6 py-4 flex items-center">
                <div class="flex items-center gap-1">
                  <span class="text-white/80 text-base font-body font-normal leading-6">{feature.notion.value}</span>
                  {feature.notion.detail && (
                    <span class="text-white/50 text-sm font-body font-normal leading-5">{feature.notion.detail}</span>
                  )}
                </div>
              </div>
              <div class="flex-1 px-6 py-4 flex items-center">
                <div class="flex items-center gap-1">
                  <span class="text-white/80 text-base font-body font-normal leading-5">{feature.obsidianSync.value}</span>
                  {feature.obsidianSync.detail && (
                    <span class="text-white/50 text-sm font-body font-normal leading-5">{feature.obsidianSync.detail}</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile Card Layout -->
      <div class="md:hidden flex flex-col gap-3">
        {features.map((feature) => (
          <div class="rounded-xl border border-white/10 overflow-hidden">
            <!-- Feature Name -->
            <div class="px-4 py-3 border-b border-white/10">
              <span class="text-white text-sm font-body font-medium leading-5">{feature.name}</span>
              <span class="text-white/60 text-xs font-body font-normal leading-4 ml-1">{feature.desc}</span>
            </div>
            <!-- Values Grid -->
            <div class="grid grid-cols-3 divide-x divide-white/10">
              <!-- NoteKit -->
              <div class="px-3 py-3 flex flex-col gap-1" style="background-color: rgba(234, 115, 23, 0.08);">
                <div class="flex items-center gap-1">
                  <span class="text-white text-xs font-body font-semibold leading-4">NoteKit</span>
                  {feature.notekit.hasCheck && (
                    <img src={star.src} alt="Star" class="w-3.5 h-3.5" />
                  )}
                </div>
                <span class="text-white text-[11px] font-body font-normal leading-4">{feature.notekit.value}</span>
                {feature.notekit.detail && (
                  <span class="text-white/60 text-[10px] font-body leading-3">{feature.notekit.detail}</span>
                )}
              </div>
              <!-- Notion -->
              <div class="px-3 py-3 flex flex-col gap-1">
                <span class="text-white/60 text-xs font-body font-semibold leading-4">Notion</span>
                <span class="text-white/60 text-[11px] font-body font-normal leading-4">{feature.notion.value}</span>
              </div>
              <!-- Obsidian Sync -->
              <div class="px-3 py-3 flex flex-col gap-1">
                <span class="text-white/60 text-xs font-body font-semibold leading-4">Obs. Sync</span>
                <span class="text-white/60 text-[11px] font-body font-normal leading-4">{feature.obsidianSync.value}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
