---
import scaleXLogo from "../assets/images/ScaleX-Logo.png";
import { FadeIn, StaggerContainer, StaggerItem } from "./ui/fade-in";

const pages = [
  { title: "Documentation", href: "https://scalex.mintlify.app/genesis-story" },
  { title: "Architecture", href: "https://scalex.mintlify.app/architecture/overview" },
  { title: "Developers", href: "https://scalex.mintlify.app/developers/mcp" },
  { title: "Launch App", href: "https://app.scalex.money" },
  { title: "FAQ", href: "/faq" },
];

const socials = [
  { title: "Twitter / X", href: "https://x.com/ScaleX_money" },
  { title: "GitHub", href: "https://github.com/ScaleX-Protocol" },
  { title: "Discord", href: "https://discord.gg/scalex" },
];

const legal = [
  { title: "Privacy Policy", href: "#" },
  { title: "Terms of Service", href: "#" },
];

const resources = [
  { title: "ERC-8004", href: "https://scalex.mintlify.app/architecture/erc8004" },
  { title: "X402 Protocol", href: "https://scalex.mintlify.app/architecture/x402" },
  { title: "Chainlink CRE", href: "https://scalex.mintlify.app/architecture/cre" },
  { title: "Contact Us", href: "mailto:team@scalex.money" },
];

const columns = [
  { title: "Pages", links: pages },
  { title: "Socials", links: socials },
  { title: "Resources", links: resources },
  { title: "Legal", links: legal },
];
---

<footer class="py-10 lg:py-20" style="background-color: #050505;">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-[120px]">
    <!-- Top border -->
    <div class="w-full h-px bg-white/10 mb-10"></div>

    <div class="flex flex-col lg:flex-row gap-10 lg:gap-20">
      <!-- Left: Logo + Copyright -->
      <FadeIn client:visible className="flex flex-col gap-4 lg:max-w-[280px]">
        <a href="/" class="flex items-center gap-1.5">
          <img
            src={scaleXLogo.src}
            alt="ScaleX Logo"
            class="w-10 h-10"
          />
          <span class="text-2xl font-heading font-bold text-white leading-8">
            ScaleX
          </span>
        </a>
        <p class="text-sm text-neutral-400 font-body leading-6">
          The capital-efficient DeFi trading protocol bridging lending and derivatives.
        </p>
        <span class="text-xs text-neutral-500 font-body mt-2">
          © 2026 ScaleX Protocol. All rights reserved.
        </span>
      </FadeIn>

      <!-- Right: 4-column grid -->
      <StaggerContainer client:visible stagger={0.12} delay={0.15} className="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 flex-1">
        {columns.map((col) => (
          <StaggerItem>
            <div class="flex flex-col gap-4">
              <h4 class="text-sm font-bold text-white font-['Schibsted_Grotesk']">{col.title}</h4>
              <ul class="flex flex-col gap-3">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.href.startsWith("http") ? "_blank" : undefined}
                      rel={link.href.startsWith("http") ? "noopener" : undefined}
                      class="text-sm text-neutral-400 hover:text-white transition-colors font-body"
                    >
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </StaggerItem>
        ))}
      </StaggerContainer>
    </div>

    <!-- Bottom: Large gradient brand text -->
    <FadeIn client:visible delay={0.3} y={20}>
      <div class="mt-16 overflow-hidden">
        <p class="text-8xl md:text-[16rem] font-heading font-bold text-center text-transparent bg-clip-text bg-gradient-to-b from-neutral-700 to-neutral-900 select-none">
          ScaleX
        </p>
      </div>
    </FadeIn>
  </div>
</footer>
