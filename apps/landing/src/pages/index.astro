---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import Benefits from "../components/Benefits.astro";
import TechStack from "../components/TechStack.astro";
import CTA from "../components/CTA.astro";
import FAQSection from "../components/FAQSection";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<Layout
  title="NoteKit — E2EE notes for humans and agents"
  description="End-to-end encrypted note-taking app backed by Git. Write in Markdown, encrypt with age, sync via your own Forgejo, GitHub, or GitLab. AI agents via MCP."
>
  <Header />
  <main>
    <Hero />
    <Features />
    <ComparisonTable />
    <Benefits />
    <TechStack />
    <CTA />
    <FAQSection client:visible />
  </main>
  <Footer />
</Layout>
