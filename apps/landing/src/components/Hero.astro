---
import PatternOrangeTop from "../assets/images/Pattern-Orange-Top.svg";
import PatternOrangeBottom from "../assets/images/Pattern-Orange-Bottom.svg";
import { HeroContent, HeroItem, HeroRight, HeroRightItem } from "./HeroAnimated";
import { HeroShader } from "./HeroShader";
---

<section
  class="relative min-h-screen flex flex-col overflow-hidden"
  style="background: linear-gradient(180deg, rgba(0, 0, 0, 1) 72%, rgba(25, 7, 3, 1) 100%); background-color: #050505;"
>
  <!-- Noise Texture Overlay -->
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none z-[2]"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;"
  >
  </div>

  <!-- Orange Grid Pattern - Top -->
  <img
    src={PatternOrangeTop.src}
    alt=""
    class="absolute top-0 left-0 w-full h-auto pointer-events-none z-[1] opacity-60"
  />

  <!-- Orange Grid Pattern - Bottom -->
  <img
    src={PatternOrangeBottom.src}
    alt=""
    class="absolute bottom-0 right-0 w-full h-auto pointer-events-none z-[1] opacity-40"
  />

  <!-- Background Glow Effect - Top Center -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[320px] pointer-events-none z-[1]"
  >
    <div
      class="w-full h-full"
      style="background: radial-gradient(ellipse at center, rgba(234,115,23,0.25) 0%, rgba(234,115,23,0.08) 40%, transparent 70%);"
    >
    </div>
  </div>

  <!-- Bottom Gradient Fade -->
  <div
    class="absolute bottom-0 left-0 right-0 h-[195px] pointer-events-none z-[2]"
    style="background: linear-gradient(to top, rgba(25, 7, 3, 1) 0%, transparent 100%);"
  >
  </div>

  <!-- Metaballs Shader hero visual -->
  <div class="w-full max-w-[900px] h-[520px] absolute top-[60px] sm:top-[100px] lg:top-[120px] left-1/2 -translate-x-1/2 rounded-3xl overflow-hidden z-[1] opacity-80">
    <HeroShader client:load />
  </div>

  <!-- Wave Pattern (decorative bottom) -->
  <div
    class="absolute bottom-0 left-0 right-0 h-[331px] pointer-events-none z-[1] opacity-20"
  >
    <svg
      class="w-full h-full"
      viewBox="0 0 1440 331"
      fill="none"
      preserveAspectRatio="none"
    >
      <path
        d="M0 165.5C120 220 360 331 720 165.5C1080 0 1320 110 1440 165.5V331H0V165.5Z"
        fill="url(#wave-gradient)"
        opacity="0.1"></path>
      <defs>
        <linearGradient id="wave-gradient" x1="0" y1="0" x2="1440" y2="331">
          <stop offset="0%" stop-color="#ea7317" stop-opacity="0.2"></stop>
          <stop offset="100%" stop-color="#ea7317" stop-opacity="0.05"></stop>
        </linearGradient>
      </defs>
    </svg>
  </div>

  <!-- Main Content -->
  <div
    class="relative z-10 flex-1 flex items-end px-4 sm:px-8 lg:px-[100px] pb-10 sm:pb-16 pt-[320px] sm:pt-[430px] lg:pt-[500px]"
  >
    <div
      class="hero-animate-init flex flex-col lg:flex-row items-start lg:items-end justify-between w-full max-w-[1240px] mx-auto gap-8 lg:gap-12"
    >
      <!-- Left: Headline + CTA -->
      <HeroContent client:load>
        <HeroItem>
          <div class="flex flex-col gap-2.5 items-start">
            <h1
              class="text-[32px] sm:text-[48px] font-body font-medium leading-[48px] sm:leading-[58px] tracking-[-1%] text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60"
            >
              Your private second brain. E2E encrypted, Git-backed, agent-ready.
            </h1>
          </div>
        </HeroItem>

        <HeroItem>
          <div class="flex items-center gap-3 sm:gap-4">
            <a
              href="https://app.notekit.online"
              target="_blank"
              rel="noopener"
              class="btn-primary text-base group"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              Open App
            </a>
            <a
              href="https://github.com/notekit-io/notekit"
              target="_blank"
              rel="noopener"
              class="btn-secondary text-base group"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          </div>
        </HeroItem>
      </HeroContent>

      <!-- Right: Description + Stats -->
      <HeroRight client:load>
        <HeroRightItem>
          <p
            class="text-[#CACACA] text-base sm:text-xl font-body font-normal leading-7 sm:leading-8 tracking-[-1%]"
          >
            Write in Markdown, encrypt with age, sync via Git. Your notes belong to you — not a cloud provider. AI agents read only what you grant them.
          </p>
        </HeroRightItem>

        <!-- Stats -->
        <HeroRightItem>
          <div class="flex items-start gap-4 sm:gap-6">
            <div class="flex flex-col gap-1 flex-1 sm:w-[144px] sm:flex-none">
              <span class="text-white text-xl sm:text-[28px] font-body font-medium leading-7 sm:leading-9 tracking-[-1%]">100%</span>
              <span class="text-[#CACACA] text-sm sm:text-lg font-body font-normal leading-5 sm:leading-[30px] tracking-[-1%]">Open Source</span>
            </div>
            <div class="self-stretch w-px flex items-center">
              <svg width="1" height="100%" viewBox="0 0 1 70" preserveAspectRatio="none" class="h-full">
                <line x1="0.5" y1="0" x2="0.5" y2="70" stroke="rgba(255,255,255,0.2)" stroke-width="1"></line>
              </svg>
            </div>
            <div class="flex flex-col gap-1 flex-1 sm:w-[144px] sm:flex-none">
              <span class="text-white text-xl sm:text-[28px] font-body font-medium leading-7 sm:leading-9 tracking-[-1%]">E2EE</span>
              <span class="text-[#CACACA] text-sm sm:text-lg font-body font-normal leading-5 sm:leading-[30px] tracking-[-1%]">By Default</span>
            </div>
            <div class="self-stretch w-px flex items-center">
              <svg width="1" height="100%" viewBox="0 0 1 70" preserveAspectRatio="none" class="h-full">
                <line x1="0.5" y1="0" x2="0.5" y2="70" stroke="rgba(255,255,255,0.2)" stroke-width="1"></line>
              </svg>
            </div>
            <div class="flex flex-col gap-1 flex-1 sm:w-[144px] sm:flex-none">
              <span class="text-white text-xl sm:text-[28px] font-body font-medium leading-7 sm:leading-9 tracking-[-1%]">MCP</span>
              <span class="text-[#CACACA] text-sm sm:text-lg font-body font-normal leading-5 sm:leading-[30px] tracking-[-1%]">Agent-Ready</span>
            </div>
          </div>
        </HeroRightItem>
      </HeroRight>
    </div>
  </div>
</section>
