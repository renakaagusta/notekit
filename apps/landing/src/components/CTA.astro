---
// CTA Section - Banner with gradient background
import bgCTA from "../assets/images/Background-CTA.png";
import pattern from "../assets/images/Pattern.svg";
import { FadeIn, StaggerContainer, StaggerItem } from "./ui/fade-in";
---

<section
  class="py-10 relative overflow-hidden"
  style="background-color: #050505;"
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-8 lg:px-[120px]">
    <!-- CTA Banner -->
    <FadeIn client:visible>
      <div
        class="relative rounded-3xl overflow-hidden px-5 py-12 sm:px-10 sm:py-20 flex flex-col items-center border border-white/5"
      >
        <!-- Background Images -->
        <div class="absolute inset-0 z-0">
          <img src={bgCTA.src} alt="" class="w-full h-full object-cover" />
        </div>
        <div class="absolute inset-0 z-0 flex items-end">
          <img
            src={pattern.src}
            alt=""
            class="w-full h-auto object-cover opacity-80 mix-blend-lighten"
          />
        </div>

        <StaggerContainer client:visible stagger={0.18} className="flex flex-col items-center">
          <!-- Heading -->
          <StaggerItem>
            <h2
              class="relative z-10 text-[28px] leading-[36px] sm:text-[40px] sm:leading-[50px] lg:text-[52px] lg:leading-[62px] font-['Schibsted_Grotesk'] font-medium tracking-[-2%] mb-4 text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60 text-center"
            >
              Own Your Notes.
            </h2>
          </StaggerItem>

          <!-- Description -->
          <StaggerItem>
            <p
              class="relative z-10 text-lg text-[#CACACA] font-body font-normal leading-7 text-center tracking-[-1%] mb-8"
            >
              Start free. No credit card. Full E2EE from day one.
            </p>
          </StaggerItem>

          <!-- CTA Buttons -->
          <StaggerItem>
            <div class="relative z-10 flex flex-col sm:flex-row items-center gap-4">
              <a
                href="https://app.notekit.online"
                target="_blank"
                rel="noopener"
                class="btn-primary text-base group"
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Open App
              </a>
              <a
                href="https://github.com/notekit-io/notekit"
                target="_blank"
                rel="noopener"
                class="btn-secondary text-base group"
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                Star on GitHub
              </a>
            </div>
          </StaggerItem>
        </StaggerContainer>
      </div>
    </FadeIn>
  </div>
</section>
