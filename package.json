{
  "name": "notekit",
  "version": "0.1.0",
  "private": true,
  "description": "Notes + tickets in your Git repo. OSS, MCP-first.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "knip": "knip",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "arch:check": "pnpm depcruise",
    "hooks:install": "git config core.hooksPath scripts/hooks"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.4",
    "@notekit/eslint-plugin": "workspace:^",
    "@types/node": "^20.12.0",
    "cleancode-kit": "github:renakaagusta/cleancode-kit#v0.1.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.4.0",
    "knip": "^6.32.2",
    "turbo": "^2.1.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0"
    }
  }
}
